# =============================================================================
# UBP EEG repo — what may be uploaded
#   LICENSE, README.md, requirements.txt, COMMIT_CHECKLIST.md, .gitignore
#   configs/  encoder/  predictor/  preprocess/  scripts/
#   data/registry.yaml  data/profiles/  data/env.example  data/README.md
#
# Everything else below is local-only (datasets, weights, analysis, manuscript).
# =============================================================================

# --- Entire trees never uploaded ---
analysis/
manuscript/
checkpoints/
pretrained/
results/

# --- Datasets (keep only small registry/profile templates under data/) ---
data/things-eeg/
data/things-meg/
data/**/Preprocessed*/
data/**/Image_set*/
data/**/Image_feature*/
data/**/ubp_preprocessed/
data/**/official_fif/
data/**/raw*/
data/**/numba_cache/
data/env.local

# Extra safety: binary / neuroimaging / media payloads anywhere
*.fif
*.edf
*.bdf
*.vhdr
*.vmrk
*.eeg
*.mat
*.h5
*.hdf5
*.parquet
*.arrow
*.csv.gz
*.tar
*.tar.gz
*.tgz
*.zip
*.7z
*.rar
*.jpg
*.jpeg
*.png
*.gif
*.webp
*.bmp
*.tif
*.tiff
*.mp4
*.avi
*.wav
*.nii
*.nii.gz

# --- Model weights / tensors / checkpoints ---
*.pth
*.pt
*.ckpt
*.safetensors
*.bin
*.pkl
*.pickle
*.npy
*.npz
*.onnx
*.params
*.weights
*.joblib

# --- Secrets / machine-local env ---
.env
.env.*
!.env.example
data/env.local

# --- Python ---
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
