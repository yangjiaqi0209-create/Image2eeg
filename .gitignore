.ipynb_checkpoints/
**/.ipynb_checkpoints/
.vscode/
.idea/
.cursor/
.DS_Store
Thumbs.db
*.swp
*.swo

# --- Training / tool caches ---
**/lightning_logs/
numba_cache/
**/numba_cache/
wandb/
runs/
mlruns/
/tmp/

