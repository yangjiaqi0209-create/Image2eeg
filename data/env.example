# Copy to data/env.local (gitignored) or export in the shell before training.
# Used by scripts/_env.sh and encoder/registry.py / data/paths.py.

# Conda env name used by scripts (default: EEG)
# CONDA_ENV=EEG

# External EEG datasets (Alljoined, …)
# Default if unset: $HOME/datasets/EEG
UBP_EEG_DATA_ROOT=$HOME/datasets/EEG

# Optional: pin repo root when cwd is unusual
# UBP_REPO_ROOT=/path/to/this/repo

# Alljoined layout under UBP_EEG_DATA_ROOT:
#   $UBP_EEG_DATA_ROOT/alljoined-1.6M/ubp_preprocessed/sub-XX/{train,test}.pt
#   $UBP_EEG_DATA_ROOT/alljoined-1.6M/clip_features/FoveaBlur/
