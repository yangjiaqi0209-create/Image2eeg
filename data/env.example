# Copy to repo root as .env or export in shell before training.
# Used by base/dataset_registry.py to resolve {eeg_data_root}.

# THINGS data lives in-repo by default (data/things-eeg/) — no env needed.

# External EEG datasets (Alljoined)
UBP_EEG_DATA_ROOT=/home/ubuntu/dataset/EEG

# Alljoined-1.6M:
#   $UBP_EEG_DATA_ROOT/alljoined-1.6M/ubp_preprocessed/sub-XX/{train,test}.pt
#   $UBP_EEG_DATA_ROOT/alljoined-1.6M/clip_features/FoveaBlur/

# Optional: override repo root when running from a non-standard cwd
# UBP_REPO_ROOT=/path/to/UBP
