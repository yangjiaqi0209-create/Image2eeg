# Copy to data/env.local (gitignored) or export in the shell before training.
# Used by scripts/_env.sh and encoder/registry.py / data/paths.py.

# Conda env name used by scripts (default: EEG)
# CONDA_ENV=EEG

# External EEG datasets (Alljoined, …)
# Default if unset: $HOME/datasets/EEG
UBP_EEG_DATA_ROOT=$HOME/datasets/EEG

# Optional: pin repo root when cwd is unusual
# UBP_REPO_ROOT=/path/to/this/repo

# Raw THINGS-EEG2 sessions (sub-XX/ses-XX). Required only when rebuilding epochs.
# THINGS_EEG_RAW_ROOT=/path/to/THINGS-EEG2/raw_eeg

# Official image_metadata.npy for the cross-subject image-id check.
# THINGS_IMAGE_METADATA=/path/to/THINGS-EEG2/image_set/image_metadata.npy

# Optional override for the ImageNet AlexNet state dict used by the Gifford baseline.
# Default: $TORCH_HOME/hub/checkpoints/alexnet-owt-7be5be79.pth
# ALEXNET_WEIGHTS=/path/to/alexnet-owt-7be5be79.pth

# Optional interpreter for launched subprocesses. Default: the current Python.
# PYTHON=/path/to/python

# Alljoined layout under UBP_EEG_DATA_ROOT:
#   $UBP_EEG_DATA_ROOT/alljoined-1.6M/ubp_preprocessed/sub-XX/{train,test}.pt
#   $UBP_EEG_DATA_ROOT/alljoined-1.6M/clip_features/FoveaBlur/
